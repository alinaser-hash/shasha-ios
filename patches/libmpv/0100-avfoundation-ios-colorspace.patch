 #endif
 
+// CVImageBufferGetColorSpace is macOS-only in the iOS SDK: build the colour space from the buffer's
+// attachments instead (autoreleased, so callers can treat it like the "Get" function).
+static CGColorSpaceRef shasha_buffer_colorspace(CVImageBufferRef buf)
+{
+    CFDictionaryRef att = CVBufferCopyAttachments(buf, kCVAttachmentMode_ShouldPropagate);
+    if (!att)
+        return NULL;
+    CGColorSpaceRef cs = CVImageBufferCreateColorSpaceFromAttachments(att);
+    CFRelease(att);
+    if (cs)
+        CFAutorelease(cs);
+    return cs;
+}
